    <formulas>
        <name>PriceBookRegionCheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(
        INCLUDES( {!$User.Price_Book_Region__c}, &apos;NA&apos;),
        INCLUDES( {!$User.Price_Book_Region__c}, &apos;CSA&apos;),
